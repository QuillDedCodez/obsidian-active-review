{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "outDir": "./.build",
        "rootDir": "..",
        "module": "CommonJS",
        "moduleResolution": "node",
        "importHelpers": false,
        "inlineSourceMap": false,
        "inlineSources": false,
        "types": ["node"]
    },
    "include": ["../src/**/*.ts", "./**/*.ts"],
    "exclude": ["./.build"]
}
